---
import Section from '../../components/Section.astro';
import {projects} from '../../data/projects';
import {url} from '../../data/site';
export function getStaticPaths() {
  return projects.map(p => ({ params: { id: p.id }, props: { p } }));
}
const {p}=Astro.props;
---
<Section title={p.title} en="PROJECT NOTES"><img class="project-img" src={url('images/'+p.image+'.webp')} alt="项目示意封面"/><p>{p.summary}</p><p>{p.placeholder?'占位项目 · ':''}{p.status} · {p.tags.join(' / ')}</p><a class="under" href={url('projects/')}>← 返回小作品</a></Section>
